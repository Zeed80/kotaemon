# Пример .env для Kotaemon. Скопировать в .env и заполнить.
# Значения из Settings → General сохраняются в .env при нажатии Save.
# Большинство настроек редактируются в Web UI (Settings → General, Resources → Ollama servers).

# === Ollama (LLM, embeddings, reranker, VLM) ===
# URL задаётся при добавлении сервера в Resources → Ollama servers и записывается сюда.
# Docker (Ollama на хосте): host.docker.internal (Win/Mac) или 172.17.0.1 (Linux)
KH_OLLAMA_URL=http://localhost:11434/v1/
OLLAMA_RERANKER_MODEL=ollama3-reranker
LOCAL_MODEL=
LOCAL_MODEL_EMBEDDINGS=nomic-embed-text

# === PyTorch (Unstructured/Docling для PDF/изображений) ===
# cuda | cpu | cu121 (Docker). По умолчанию GPU. Редактируется в Settings → General.
TORCH_DEVICE=cuda

# === Qdrant (векторное хранилище) ===
# Docker: QDRANT_URL задаётся в docker-compose
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=   # для Qdrant Cloud
# QDRANT_PATH=      # для file-режима без сервера

# === OpenAI (если используется) ===
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# === Другие API (Cohere, Mistral и т.д. — в Settings → General) ===
COHERE_API_KEY=
MISTRAL_API_KEY=
VOYAGE_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# === Azure OpenAI ===
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# === GraphRAG (флаги в Settings → General) ===
USE_LIGHTRAG=true
USE_NANO_GRAPHRAG=true
USE_MS_GRAPHRAG=true
USE_GLOBAL_GRAPHRAG=true
# USE_CUSTOMIZED_GRAPHRAG_SETTING=false

# === Поиск в вебе ===
SEARXNG_URL=http://localhost:8080

# === Multimodal / VLM (Docling, Adobe) ===
USE_MULTIMODAL=false
OPENAI_VISION_DEPLOYMENT_NAME=gpt-4o

# === Прочее ===
# PDF.js
PDFJS_VERSION_DIST=pdfjs-4.0.379-dist
# Adobe PDF Services (опционально)
# PDF_SERVICES_CLIENT_ID=
# PDF_SERVICES_CLIENT_SECRET=

# === Аутентификация ===
# AUTHENTICATION_METHOD=KEYCLOAK  # или пусто
# KEYCLOAK_SERVER_URL=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_REALM=
# KEYCLOAK_CLIENT_SECRET=
